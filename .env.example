DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
SQLITE_PATH=db.sqlite3
TELEGRAM_BOT_TOKEN=
# Label photos in Telegram and WhatsApp use OpenAI vision. Keep this key local.
OPEN_AI_KEY=
OPEN_AI_VISION_MODEL=gpt-4.1-mini
# Empty: anyone can search in a private chat. Or enter comma-separated Telegram user IDs.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_VOICE_ENABLED=0
TELEGRAM_VOICE_MODEL=models/whisper-small

# WhatsApp Cloud API. Incoming messages use the same inventory and voice model.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Empty: anyone can search. Or enter comma-separated WhatsApp phone numbers.
WHATSAPP_ALLOWED_USER_IDS=
# Defaults to TELEGRAM_VOICE_ENABLED when omitted.
# WHATSAPP_VOICE_ENABLED=1

# Leave POSTGRES_DB empty to use the local SQLite database.
# POSTGRES_DB=tema_reagents
# POSTGRES_USER=tema_reagents
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Production HTTPS settings (used when DJANGO_DEBUG=0).
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=1
