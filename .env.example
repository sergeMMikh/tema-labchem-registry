DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
SQLITE_PATH=db.sqlite3
TELEGRAM_BOT_TOKEN=
# Empty: anyone can search in a private chat. Or enter comma-separated Telegram user IDs.
TELEGRAM_ALLOWED_USER_IDS=

# Leave POSTGRES_DB empty to use the local SQLite database.
# POSTGRES_DB=tema_reagents
# POSTGRES_USER=tema_reagents
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Production HTTPS settings (used when DJANGO_DEBUG=0).
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_SSL_REDIRECT=1
